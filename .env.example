# ─────────────────────────────────────────────────────────────────────────────
# Ghumakkars — environment variables
#
# Local:      copy to .env.local (git-ignored) and fill in.
# Production: add each one in Coolify → your app → Environment Variables,
#             then Redeploy. Coolify does not read .env.local.
#
# NEXT_PUBLIC_* values are baked into the browser bundle at BUILD time —
# in Coolify tick "Build Variable" for them (and redeploy after changing).
# Everything else is read at runtime — leave "Build Variable" unticked.
#
# Never commit real values. This file only documents the names.
# ─────────────────────────────────────────────────────────────────────────────


# ── Supabase (required) ──────────────────────────────────────────────────────
# Supabase dashboard → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=


# ── Site address (required) ──────────────────────────────────────────────────
# Used in emails, password-reset links and Instagram trip-card buttons.
# Local: http://localhost:3000    Production: https://ghumakkars.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional. Base URL for Telegram links and the Razorpay → notification call.
# Falls back to the request's own address (or http://localhost:3000).
NEXT_PUBLIC_APP_URL=


# ── Email: Hostinger SMTP (required for OTP / booking emails) ────────────────
SMTP_HOST=smtp.hostinger.com
# 465 = SSL (secure is decided from the port automatically)
SMTP_PORT=465
SMTP_USER=noreply@ghumakkars.in
SMTP_PASS=
FROM_EMAIL=noreply@ghumakkars.in
FROM_NAME=Ghumakkars


# ── Cloudinary: image uploads (required) ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ── Razorpay: online payments (required for card/UPI checkout) ───────────────
# Local: use TEST keys (rzp_test_…) so no real money moves.
# Production: LIVE keys (rzp_live_…).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Razorpay dashboard → Webhooks → the secret you typed when creating the webhook.
RAZORPAY_WEBHOOK_SECRET=


# ── Internal server-to-server auth (required) ────────────────────────────────
# Any long random string (e.g. `openssl rand -hex 32`). Same value everywhere
# the app runs, so internal calls (webhook → send-notification) are trusted.
INTERNAL_API_SECRET=


# ── Instagram (admin → Instagram) ────────────────────────────────────────────
# Long-lived / System User token from Meta (starts with EAA…).
INSTAGRAM_ACCESS_TOKEN=
# Your Instagram professional account ID (17841…).
INSTAGRAM_USER_ID=
# Business Discovery + messaging use graph.facebook.com for EAA tokens.
INSTAGRAM_API_BASE=https://graph.facebook.com/v21.0
# Webhook (Meta → Webhooks → Instagram). Any random text; type the same value
# into Meta's "Verify token" box. Callback URL: https://ghumakkars.in/api/webhooks/instagram
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Meta App → App settings → Basic → App secret. Optionally add the Instagram
# app secret after a comma: <meta_secret>,<instagram_secret>
INSTAGRAM_APP_SECRET=


# ── Optional features ────────────────────────────────────────────────────────
# AI-written emails in admin → Users → Email → Generate. Leave empty to disable.
NVIDIA_API_KEY=


# ── WhatsApp (optional tuning — sensible defaults are built in) ──────────────
# Set to 1 to stop the WhatsApp client starting (e.g. a second server / local dev
# while production is connected — only ONE process may hold the session).
WHATSAPP_DISABLED=
# The WhatsApp login is stored in Supabase (table whatsapp_auth) — no volume needed.
# WA_DATA_DIR only holds the send queue + logs. Default: ./data/whatsapp
WA_DATA_DIR=
# WhatsApp is OFF in `npm run dev` (it would share the live login). Set to 1 to turn it on.
WA_DEV_ENABLE=
# Logging / queue tuning (defaults shown)
WA_BAILEYS_LOG_LEVEL=silent
WA_MAX_RECONNECT_DELAY_MS=60000
WA_MAX_QUEUE_SIZE=100
WA_QUEUE_RETRY_MS=15000
WA_QUEUE_MAX_ATTEMPTS=12
WA_BAD_SESSION_RECOVERY_ATTEMPTS=3
WA_LOG_MAX_BYTES=5000000
